{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "1.0.0",
  "id": "00000000-0000-0000-0000-000000000000",
  "packageName": "org.example.foosbot",
  "developer": {
    "name": "FoosBot Demo",
    "websiteUrl": "https://example.org",
    "privacyUrl": "https://example.org/privacy",
    "termsOfUseUrl": "https://example.org/terms"
  },
  "name": {
    "short": "FoosBot",
    "full": "FoosBot — kolejka do piłkarzyków"
  },
  "description": {
    "short": "Kolejka do piłkarzyków z ręcznym GO.",
    "full": "Zapisy +1/-1, ręczne GO, blokada drugiego składu podczas trwającego meczu i zakończenie gry zwalniające stół."
  },
  "icons": {
    "outline": "outline.png",
    "color": "color.png"
  },
  "accentColor": "#166534",
  "bots": [
    {
      "botId": "00000000-0000-0000-0000-000000000000",
      "scopes": [
        "team",
        "groupchat",
        "personal"
      ],
      "isNotificationOnly": false,
      "supportsFiles": false,
      "commandLists": [
        {
          "scopes": [
            "team",
            "groupchat",
            "personal"
          ],
          "commands": [
            {
              "title": "status",
              "description": "Stan stołu i przyciski"
            },
            {
              "title": "+1",
              "description": "Dołącz do kolejki"
            },
            {
              "title": "-1",
              "description": "Wypisz się"
            },
            {
              "title": "go",
              "description": "Rozpocznij mecz (gdy stół wolny)"
            },
            {
              "title": "koniec",
              "description": "Zakończ obecny mecz"
            }
          ]
        }
      ]
    }
  ],
  "validDomains": []
}
